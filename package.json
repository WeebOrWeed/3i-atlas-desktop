{
    "name":  "atlas-desktop-shell",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Atlas desktop shell - cloud console/API client for the 3I Atlas platform",
    "main":  "src/main.js",
    "type":  "commonjs",
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder",
                    "dist:dir":  "electron-builder --dir"
                },
    "devDependencies":  {
                            "electron":  "^33.3.1",
                            "electron-builder":  "^25.1.8"
                        },
    "build":  {
                  "appId":  "dev.3i-atlas.desktop",
                  "productName":  "3I Atlas",
                  "files":  [
                                "src/**/*",
                                "assets/**/*",
                                "package.json"
                            ],
                  "directories":  {
                                      "output":  "release"
                                  },
                  "mac":  {
                              "category":  "public.app-category.finance",
                              "target":  [
                                             {
                                                 "target":  "dmg",
                                                 "arch":  [
                                                              "arm64",
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "identity":  null
                          },
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ]
                          },
                  "linux":  {
                                "target":  [
                                               "AppImage"
                                           ]
                            }
              }
}
